<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android"
 android:id="@+id/swipeRefresh" android:layout_width="match_parent" android:layout_height="match_parent">
 <ScrollView android:layout_width="match_parent" android:layout_height="match_parent">
  <LinearLayout android:orientation="vertical" android:padding="16dp" android:layout_width="match_parent" android:layout_height="wrap_content">
   <TextView android:text="SHOP FOOD_KCN" android:textSize="28sp" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
   <LinearLayout android:id="@+id/loginPanel" android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content">
    <TextView android:text="Khu công nghiệp" android:textSize="13sp" android:paddingTop="8dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    <Spinner android:id="@+id/kcnSpinner" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <EditText android:id="@+id/username" android:hint="Tên đăng nhập" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <EditText android:id="@+id/password" android:hint="Mật khẩu" android:inputType="textPassword" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <Button android:id="@+id/loginBtn" android:text="Đăng nhập" android:layout_width="match_parent" android:layout_height="wrap_content"/>
   </LinearLayout>
   <LinearLayout android:id="@+id/contractPanel" android:visibility="gone" android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content">
    <TextView android:text="📄 HỢP ĐỒNG HỢP TÁC COM11H.COM" android:textSize="22sp" android:textStyle="bold" android:paddingTop="12dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <TextView android:id="@+id/contractStatus" android:paddingTop="8dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <ScrollView android:layout_width="match_parent" android:layout_height="360dp" android:layout_marginTop="10dp">
     <TextView android:id="@+id/contractBody" android:textSize="14sp" android:padding="12dp" android:background="#F4F4F4" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    </ScrollView>
    <EditText android:id="@+id/contractName" android:hint="Họ và tên người xác nhận" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <CheckBox android:id="@+id/contractAgree" android:text="Tôi đã đọc, hiểu và đồng ý với toàn bộ Hợp đồng hợp tác này." android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <Button android:id="@+id/signContractBtn" android:text="✍️ Xác nhận ký hợp đồng" android:layout_width="match_parent" android:layout_height="wrap_content"/>
   </LinearLayout>
   <LinearLayout android:id="@+id/appPanel" android:visibility="gone" android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content">
    <TextView android:id="@+id/storeBadge" android:textStyle="bold" android:textSize="17sp" android:paddingTop="8dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <TextView android:id="@+id/status" android:paddingTop="8dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content">
     <Button android:id="@+id/refreshBtn" android:text="↻ Đồng bộ" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"/>
     <Button android:id="@+id/logoutBtn" android:text="Đăng xuất" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"/>
    </LinearLayout>
    <LinearLayout android:id="@+id/menuBox" android:orientation="horizontal" android:weightSum="3" android:layout_width="match_parent" android:layout_height="wrap_content">
     <Button android:id="@+id/newTab" android:text="Đơn mới" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"/>
     <Button android:id="@+id/prepTab" android:text="Đang làm" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"/>
     <Button android:id="@+id/historyTab" android:text="Lịch sử" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"/>
    </LinearLayout>
    <LinearLayout android:id="@+id/secondaryMenu" android:orientation="horizontal" android:weightSum="3" android:layout_width="match_parent" android:layout_height="wrap_content">
     <Button android:id="@+id/foodsTab" android:text="🍜 Món ăn" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"/>
     <Button android:id="@+id/ledgerTab" android:text="💰 Đối soát" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"/>
     <Button android:id="@+id/accountTab" android:text="🔐 Tài khoản" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"/>
    </LinearLayout>
    <LinearLayout android:id="@+id/contentBox" android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content"/>
   </LinearLayout>
   <TextView android:id="@+id/loginStatus" android:paddingTop="12dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
  </LinearLayout>
 </ScrollView>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
